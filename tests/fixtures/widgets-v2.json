{
  "openapi": "3.0.0",
  "info": {
    "title": "Widgets",
    "version": "2026-06-01"
  },
  "components": {
    "schemas": {
      "Shipping": {
        "type": "object",
        "description": "Where the widget goes.",
        "properties": {
          "address": {
            "type": "string",
            "maxLength": 200
          },
          "method": {
            "type": "string",
            "enum": [
              "ground",
              "air"
            ]
          }
        },
        "required": []
      }
    }
  },
  "paths": {
    "/v1/widgets": {
      "get": {
        "operationId": "ListWidgets",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "active"
              ]
            }
          },
          {
            "name": "account",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      },
      "post": {
        "operationId": "CreateWidget",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 50,
                    "description": "Widget name."
                  },
                  "amount": {
                    "type": "string",
                    "description": "Amount in minor units (cents)."
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "fast",
                      "slow",
                      "turbo",
                      "instant"
                    ]
                  },
                  "shipping": {
                    "$ref": "#/components/schemas/Shipping"
                  },
                  "note": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 50
                      },
                      {
                        "type": "string",
                        "enum": [
                          ""
                        ]
                      }
                    ],
                    "description": "Free-form note."
                  },
                  "tags": {
                    "type": "array",
                    "description": "Labels."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/v1/widgets/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "UpdateWidget",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/v1/gadgets": {
      "post": {
        "operationId": "CreateGadget",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    }
  }
}
